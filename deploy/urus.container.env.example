# Copy to a private file and pass it as ENV_FILE to deploy_apple_container.sh.
APP_ENV=production
# DATABASE_URL, MOOMOO_SDK_HOME, URUS_SCHEDULER_DATA_DIR and
# MOOMOO_COLLECTION_LOCK_PATH are deployment
# invariants injected by the script and always point into the host-mounted /data.
MARKET_TIMEZONE=America/New_York
MARKET_CALENDAR=XNYS
MOOMOO_ENABLED=true
# For OpenD on the Mac mini host, configure an Apple-container host alias and
# use that host name. For OpenD on another LAN machine, use its LAN IP.
MOOMOO_HOST=<opend-host>
MOOMOO_PORT=11111
# Dedicated SPY/QQQ/IWM intraday option collector. Its SQLite database and raw
# payload archive live under /data/intraday_options, separate from urus.db.
INTRADAY_OPTIONS_ENABLED=true
INTRADAY_OPTIONS_SYMBOLS=SPY,QQQ,IWM
INTRADAY_OPTIONS_FAST_BAND_PERCENT=3
INTRADAY_OPTIONS_STRUCTURE_BAND_PERCENT=10
INTRADAY_OPTIONS_POLL_SECONDS=10
INTRADAY_OPTIONS_MIN_QUOTE_COVERAGE=0.80
INTRADAY_OPTIONS_CLOSE_FINALIZER_DELAY_MINUTES=5
INTRADAY_OPTIONS_BACKUP_RETENTION_DAYS=14
OBSERVATION_UNIVERSE_SOURCE_URL=
OBSERVATION_UNIVERSE_SYNC_TIMEOUT_SECONDS=15
OBSERVATION_ALLOW_STALE_UNIVERSE=false
CAPITAL_FLOW_SYMBOLS=SPY,QQQ,SMH,SOXX,IGV
CAPITAL_FLOW_CACHE_DAYS=30
CAPITAL_FLOW_PROJECTION_DAYS=5
FRED_ENABLED=true
YAHOO_ENABLED=true
# Optional published remote decision runtime. Keep the service token in the
# deployment secret store and allowlist only the configured Workflow refs.
ANOMALO_BASE_URL=
ANOMALO_WORKFLOW_ENABLED=true
ANOMALO_WORKFLOW_TOKEN=<secret-store>
ANOMALO_WORKFLOW_CONNECT_TIMEOUT_SECONDS=10
ANOMALO_WORKFLOW_READ_TIMEOUT_SECONDS=1200
ANOMALO_WORKFLOW_FAKE_ADAPTER=false
REMOTE_DECISION_MAX_INPUT_BYTES=500000
REMOTE_DECISION_MAX_CROSS_SECTION_ROWS=1000
REMOTE_DECISION_MAX_NOTABLE_CARDS=20
REMOTE_DECISION_EVENT_POLL_LIMIT=500
REMOTE_DECISION_MAX_POLLS=4800
SCHEDULED_POST_CLOSE_ENABLED=true
