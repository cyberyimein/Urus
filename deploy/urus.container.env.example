# Copy to a private file and pass it as ENV_FILE to deploy_apple_container.sh.
APP_ENV=production
# DATABASE_URL, MOOMOO_SDK_HOME and URUS_SCHEDULER_DATA_DIR are deployment
# invariants injected by the script and always point into the host-mounted /data.
MARKET_TIMEZONE=America/New_York
MOOMOO_ENABLED=true
# For OpenD on the Mac mini host, configure an Apple-container host alias and
# use that host name. For OpenD on another LAN machine, use its LAN IP.
MOOMOO_HOST=opend-host
MOOMOO_PORT=11111
FRED_ENABLED=true
YAHOO_ENABLED=true
ANOMALO_ENABLED=true
ANOMALO_BASE_URL=
ANOMALO_TIMEOUT_SECONDS=600
WORKFLOW_RESEARCH_VARIANT=cta
URUS_AGENT_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
URUS_AGENT_MODEL=deepseek/deepseek-v4-flash-0731
URUS_AGENT_TIMEOUT_SECONDS=1200
SCHEDULED_PRE_MARKET_ENABLED=true
SCHEDULED_PRE_MARKET_SKIP_AI_DECISION=false
SCHEDULED_PRE_CLOSE_ENABLED=true
SCHEDULED_PRE_CLOSE_SKIP_AI_DECISION=true
SCHEDULED_POST_CLOSE_ENABLED=true
SCHEDULED_POST_CLOSE_SKIP_AI_DECISION=false
