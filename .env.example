APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./urus.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLED_SYMBOLS=QQQ,INTC
MOOMOO_ENABLED=false
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
# Development validation is intentionally limited to QQQ and INTC.
# After validation, production can add SPY,SMH,IGV and configured watchlist symbols.
OPTIONS_TARGET_SYMBOLS=QQQ,INTC
OPTIONS_TARGET_DTES=0,7,30,60,90
OPTIONS_MAX_DTE=90
OPTIONS_STRIKE_RANGE_PERCENT=20
OPTIONS_SNAPSHOT_BATCH_SIZE=400
ANOMALO_ENABLED=false
ANOMALO_BASE_URL=
ANOMALO_TIMEOUT_SECONDS=10

# Optional frontend override:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
