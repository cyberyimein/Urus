APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./urus.db
OBSERVATION_UNIVERSE_SOURCE_URL=
OBSERVATION_UNIVERSE_SYNC_TIMEOUT_SECONDS=15
OBSERVATION_ALLOW_STALE_UNIVERSE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLED_SYMBOLS=QQQ,INTC
# Stage 3A full technical universe; QQQ is added automatically as the benchmark.
INSTRUMENT_VALIDATION_SYMBOLS=SPY,SMH,IGV,LITE,COHR,MRVL,NOK,AMD,INTC,NVDA,NBIS,ORCL,MSFT,NOW,RKLB,AMZN,AAPL,GOOG
MOOMOO_ENABLED=false
# OpenD may run on another machine in the development LAN.
MOOMOO_HOST=opend-host
MOOMOO_PORT=11111
# Core option ETFs plus the confirmed public-equity watchlist.
OPTIONS_TARGET_SYMBOLS=SPY,QQQ,SMH,IGV
OPTIONS_WATCHLIST_SYMBOLS=LITE,COHR,MRVL,NOK,AMD,INTC,NVDA,NBIS,ORCL,MSFT,NOW,RKLB,AMZN,AAPL,GOOG
# SPCX represents private SpaceX exposure and cannot be queried as a listed option underlying.
OPTIONS_WATCHLIST_EXCLUDED_SYMBOLS=SPCX
OPTIONS_TARGET_DTES=0,7,30,60,90
OPTIONS_MAX_DTE=90
OPTIONS_STRIKE_RANGE_PERCENT=20
OPTIONS_SNAPSHOT_BATCH_SIZE=400
OPTIONS_SNAPSHOT_INTERVAL_SECONDS=0.75
OPTIONS_CHAIN_INTERVAL_SECONDS=3.5
OPTIONS_GAMMA_PROFILE_RANGE_PERCENT=30
OPTIONS_GAMMA_PROFILE_POINTS=121
OPTIONS_RISK_FREE_RATE_PERCENT=4
OPTIONS_DIVIDEND_YIELD_PERCENT=0
MOOMOO_HISTORY_DAYS=260
MOOMOO_SDK_HOME=data/moomoo_home
MOOMOO_MARKET_SYMBOLS=QQQ,SPY,IWM,DIA,RSP,SMH,SOXX,IGV,HYG,LQD,TLT,IEF,UUP,GLD,USO
# Daily order-size capital-flow cache: fetch only the latest completed session and project five days.
CAPITAL_FLOW_SYMBOLS=SPY,QQQ,SMH,SOXX,IGV
CAPITAL_FLOW_CACHE_DAYS=30
CAPITAL_FLOW_PROJECTION_DAYS=5
MARKET_TIMEZONE=America/New_York
MARKET_CALENDAR=XNYS
FRED_ENABLED=false
FRED_BASE_URL=https://fred.stlouisfed.org/graph/fredgraph.csv
FRED_TIMEOUT_SECONDS=10
FRED_LOOKBACK_DAYS=30
YAHOO_ENABLED=false
YAHOO_BASE_URL=https://query2.finance.yahoo.com/v8/finance/chart
YAHOO_TIMEOUT_SECONDS=10
YAHOO_LOOKBACK_DAYS=30
ANOMALO_BASE_URL=
# Phase D published Workflow runtime (keep token in Secret Store, never /api/settings).
ANOMALO_WORKFLOW_ENABLED=false
ANOMALO_WORKFLOW_TOKEN=
ANOMALO_WORKFLOW_CONNECT_TIMEOUT_SECONDS=10
ANOMALO_WORKFLOW_READ_TIMEOUT_SECONDS=1200
ANOMALO_WORKFLOW_FAKE_ADAPTER=false
REMOTE_DECISION_MAX_INPUT_BYTES=500000
REMOTE_DECISION_MAX_CROSS_SECTION_ROWS=1000
REMOTE_DECISION_MAX_NOTABLE_CARDS=20
REMOTE_DECISION_EVENT_POLL_LIMIT=500
REMOTE_DECISION_MAX_POLLS=4800
# CTA branch default. Set events only when deploying the legacy event overlay.
WORKFLOW_RESEARCH_VARIANT=cta
CTA_PROXY_SYMBOLS=SPY,QQQ,IWM,IEF,TLT,UUP,GLD,USO,HYG,LQD,SMH,IGV

# Optional frontend override:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
